package-as: VolumeSliders
enable-nolib-creation: no
enable-toc-creation: yes

move-folders:
  VolumeSliders/VolumeSliders: VolumeSliders

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - local_dev_assets
  - docs
  - GEMINI.md
  - AGENTS.md
  - AGENTS.local.md
  - AGENTS.override.md
  - CLAUDE.md
  - CLAUDE.local.md
  - .agent
  - .agents
  - .claude
  - .codex
  - .mcp.json
  - spec
  - .luarc.json
  - .busted
